<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/>
    </parent>

    <groupId>com.template</groupId>
    <artifactId>project-template</artifactId>
    <name>project-template</name>
    <version>0.0.1-SNAPSHOT</version>
    <description>Project template is a microservice application, with basic logic to work as a template for any application with concrete logic</description>
    <packaging>pom</packaging>



    <modules>
        <module>orders-service</module>
        <module>products-service</module>
        <module>users-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <spring-boot.version>3.4.4</spring-boot.version>
        <docker-compose.version>1.0.0</docker-compose.version>
    </properties>
</project>